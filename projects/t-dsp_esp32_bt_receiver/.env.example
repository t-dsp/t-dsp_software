# Copy this file to `.env` (same folder) and fill in your values.
#
#   cp .env.example .env
#
# `.env` is gitignored -- secrets must never be committed. tools/load_env.py reads it at
# build time and injects each KEY=VALUE as -DKEY="VALUE" (always a C string literal), so
# the tracked platformio.ini stays free of credentials.
#
# Only the WiFi build (-D TDSP_CTRL_WIFI / env:esp32dev_wifi) uses these. Without a .env
# the build still succeeds but emits a #warning and the ESP32 won't join a network.
#
# NOTE: the classic ESP32 has no 5 GHz radio -- this MUST be a 2.4 GHz network, and the
# same LAN as the device running the app (so tdsp.local resolves).
#
# Credentials are baked into the image in this phase; runtime provisioning is a later
# phase. Re-flash to change networks.

TDSP_WIFI_SSID=MyNetwork
TDSP_WIFI_PASS=MyPassword

# --- Access point + hosted web UI (WiFi build only) ---------------------------------
# The ESP32 ALWAYS raises its own access point (AP+STA) so the control UI works with no
# router / no internet (festival). Phones join this SSID and open http://192.168.4.1/
# (or http://tdsp.local/) -- the captive portal pushes them there. WPA2 needs >= 8 chars.
# Leave TDSP_WIFI_SSID empty above to run AP-only.
TDSP_AP_SSID=T-DSP
TDSP_AP_PASS=tdsp1234
# Shared secret tools/push_ui.py must present (X-Token header) to replace the hosted UI.
TDSP_UI_TOKEN=change-me
